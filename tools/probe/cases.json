  "loopback": [
    {
      "_comment": "语义层基准：服务端只有 l TCP 入站。如果客户端配置里写了别的 transport 还能连通, 说明它把不认识的 transport **静默当成 tcp** —— 这正是本项目要挡的东西。",
      "id": "loopback.xray_server_tcp__mihomo_client_tcp",
      "feature": "transport.tcp",
      "server_kernel": "xray",
      "client_kernel": "mihomo",
      "server_config": {
        "log": {
          "loglevel": "warning",
          "access": "none",
          "error": "none"
        },
        "inbounds": [
          {
            "listen": "127.0.0.1",
            "port": 18443,
            "protocol": "vless",
            "settings": {
              "clients": [
                {
                  "id": "11111111-1111-1111-1111-111111111111"
                }
              ],
              "decryption": "none"
            },
            "streamSettings": {
              "network": "tcp"
            }
          }
        ],
        "outbounds": [
          {
            "protocol": "freedom"
          }
        ]
      },
      "client_config": {
        "mixed-port": 17890,
        "log-level": "warning",
        "proxies": [
          {
            "name": "n",
            "type": "vless",
            "server": "127.0.0.1",
            "port": 18443,
            "uuid": "11111111-1111-1111-1111-111111111111",
            "network": "tcp"
          }
        ],
        "rules": [
          "MATCH,n"
        ]
      },
      "client_proxy_port": 17890
    },
    {
      "_comment": "**静默降级探测器**: 把 network 写成根本不存在的值。预期是**连不上**; 如果连上了 = 该内核把不认识的 transport 静默当成 tcp（实测就是这样）。",
      "id": "loopback.xray_server_tcp__mihomo_client_nonsense_transport",
      "feature": "transport.unknown_silent_fallback",
      "server_kernel": "xray",
      "client_kernel": "mihomo",
      "server_config": {
        "log": {
          "loglevel": "warning",
          "access": "none",
          "error": "none"
        },
        "inbounds": [
          {
            "listen": "127.0.0.1",
            "port": 18443,
            "protocol": "vless",
            "settings": {
              "clients": [
                {
                  "id": "11111111-1111-1111-1111-111111111111"
                }
              ],
              "decryption": "none"
            },
            "streamSettings": {
              "network": "tcp"
            }
          }
        ],
        "outbounds": [
          {
            "protocol": "freedom"
          }
        ]
      },
      "client_config": {
        "mixed-port": 17890,
        "log-level": "warning",
        "proxies": [
          {
            "name": "n",
            "type": "vless",
            "server": "127.0.0.1",
            "port": 18443,
            "uuid": "11111111-1111-1111-1111-111111111111",
            "network": "totally-nonsense-transport"
          }
        ],
        "rules": [
          "MATCH,n"
        ]
      },
      "client_proxy_port": 17890,
      "expect_connect": false
    },
    {
